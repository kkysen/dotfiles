[user]
	name = kkysen
	email = kkysen@gmail.com

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[alias]
	st = status
	cp = cherry-pick
	amend = commit --amend

[core]
	editor = nano
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[rerere]
	enabled = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[merge]
	conflictstyle = zdiff3

[fetch]
	prune = true

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
